# Text is stored with LF; Windows scripts are checked out with CRLF everywhere (also in CI,
# which builds the release ZIP on Linux).
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.ico binary
*.dll binary
*.zip binary
